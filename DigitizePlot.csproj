<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Digitize.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Digitize.png" />
    <None Remove="Images\Clear.png" />
    <None Remove="Images\ClipboardIn.png" />
    <None Remove="Images\ClipboardOut.png" />
    <None Remove="Images\Open.png" />
    <None Remove="Images\OpenImage.png" />
    <None Remove="Images\Save.png" />
    <None Remove="Plot.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Digitize.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Digitize.png" />
    <Resource Include="Images\Clear.png" />
    <Resource Include="Images\ClipboardIn.png" />
    <Resource Include="Images\ClipboardOut.png" />
    <Resource Include="Images\New.png" />
    <Resource Include="Images\Open.png" />
    <Resource Include="Images\OpenImage.png" />
    <Resource Include="Images\Save.png" />
    <Resource Include="Plot.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
